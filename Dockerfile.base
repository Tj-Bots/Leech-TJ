# Base image with every Python package installed. Built by GitHub Actions
# (.github/workflows/image.yml) and used by Dockerfile.heroku for fast deploys.
FROM mysterysd/wzmlx:latest

WORKDIR /usr/src/app
RUN chmod 777 /usr/src/app

COPY requirements.txt .
RUN pip3 install --upgrade setuptools wheel setuptools-scm
RUN pip3 uninstall -y pyrogram pyrofork pyrotgfork || true
RUN pip3 install --no-cache-dir -r requirements.txt
